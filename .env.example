# =============================================================================
# Siksha Saathi - Fullstack Next.js Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database (Local Docker PostgreSQL or Cloud NeonDB)
# -----------------------------------------------------------------------------
# Local Docker PostgreSQL (Preferred for <1ms latency):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siksha_saathi
# Cloud NeonDB (Alternative):
# DATABASE_URL=postgresql://username:password@ep-xxxxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# -----------------------------------------------------------------------------
# 2. Google Gemini API (LLM & Embeddings)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# 3. Authentication & Security
# -----------------------------------------------------------------------------
# CRITICAL: Must be a long, cryptographically secure random string in production!
JWT_SECRET=your-super-secret-jwt-signing-key-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Note: Students cannot self-register. Admins enroll students via the portal
# (CSV import or single-add) and set an initial password per batch. There are
# no academic defaults — every enrolled student must have stream/semester/section provided.
# Default initial student password (used when none is specified on enroll/single-add/reset)
DEFAULT_STUDENT_PASSWORD=student123

# -----------------------------------------------------------------------------
# 4. Google Cloud Platform (GCP) OAuth 2.0
# -----------------------------------------------------------------------------
# Public client ID for the Google Sign-In button in browser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# -----------------------------------------------------------------------------
# 5. Cloud Storage (Cloudflare R2 - Preferred with $0 Egress & Sub-30ms CDN)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=r2 # Options: 'r2' (default) or 'dropbox'

# Cloudflare R2 S3-Compatible Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=siksha-saathi
R2_PUBLIC_DOMAIN=https://pub-your-bucket-id.r2.dev

# -----------------------------------------------------------------------------
# 6. Dropbox Storage (Fallback)
# -----------------------------------------------------------------------------
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
DROPBOX_FOLDER_PATH=/siksha_saathi

# -----------------------------------------------------------------------------
# 7. Hybrid RAG Retrieval & Reranking Pipeline
# -----------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=10
HYBRID_VECTOR_LIMIT=25
HYBRID_KEYWORD_LIMIT=15
RRF_K=60
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TIMEOUT_MS=5000
RAG_SIMILARITY_THRESHOLD=0.25

# -----------------------------------------------------------------------------
# 8. Database Seeding Configuration (Used by 'npm run db:seed')
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@sikshasaathi.in
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Siksha Saathi Administrator
SEED_ORG_NAME=Siksha Saathi College
