{
  "name": "siksha-saathi",
  "version": "2.0.0",
  "private": true,
  "description": "Unified Fullstack Next.js Application for Siksha Saathi",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "get-dropbox-token": "node scripts/get-dropbox-token.mjs",
    "db:init": "node db-scripts/init-schema.mjs",
    "db:seed": "node db-scripts/seed.mjs",
    "db:validate": "node db-scripts/validate.mjs",
    "db:verify": "node db-scripts/validate.mjs",
    "db:clear": "node db-scripts/clear.mjs",
    "db:reset": "node db-scripts/reset.mjs",
    "db:setup": "node db-scripts/init-schema.mjs && node db-scripts/seed.mjs && node db-scripts/validate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:fresh": "node db-scripts/clear.mjs && drizzle-kit push && node db-scripts/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@google/generative-ai": "0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "^0.45.2",
    "dropbox": "10.44.0",
    "framer-motion": "13.0.0",
    "google-auth-library": "11.0.0",
    "jose": "6.2.8",
    "lucide-react": "1.31.0",
    "next": "^16.3.0",
    "pg": "8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "drizzle-kit": "^0.31.10",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  }
}
