# =============================================================================
# Siksha Saathi — Ingestion Worker (deploy separately on Render / any Node host)
# =============================================================================

# NeonDB connection (same DATABASE_URL as the web app)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Google Gemini (embeddings)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Cloudflare R2 (download uploaded files)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=siksha-saathi
R2_PUBLIC_DOMAIN=https://pub-xxx.r2.dev

# Dropbox fallback (download)
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token

# Worker tuning
POLL_INTERVAL_MS=5000
OCR_MAX_PAGES=50          # cap OCR rendering for huge scanned PDFs
OCR_MIN_TEXT_CHARS=20     # per-page threshold to trigger OCR
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CONCURRENT_JOBS=1     # process N jobs in parallel (keep 1 to bound memory)
# OCR languages (multilingual by default). Add/remove ISO 639-3 codes joined by '+'.
# Common Indian languages: hin ben tam tel mar guj kan mal ori pan san urd
TESSERACT_LANGS=eng+hin
