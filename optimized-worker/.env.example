# Copy from root .env.local or set manually
# DATABASE_URL=postgresql://...
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=siksha-saathi

# Local embedding model
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOCAL_EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# OCR
TESSERACT_LANGS=eng+hin

# Chunking (must match Node worker for fair comparison)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Worker
POLL_INTERVAL_MS=5000
MAX_ATTEMPTS=3

# Benchmark (set to true to record per-job timings)
BENCHMARK_MODE=false
